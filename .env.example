# Which chain the app talks to. Contract addresses and the explorer follow this.
#
# Leave unset (or use "mainnet") for real trading. A misspelled value aborts
# startup. Use "testnet" to exercise the wallet-to-node path with worthless
# coins first; contract tests cannot validate a real wallet or node.
NEXT_PUBLIC_ERGO_NETWORK=mainnet

# Set to "true" only if this deployment also serves the full-size originals from
# public/art (about 2 GB, not committed). Leaving it unset keeps the app from
# requesting a path that is guaranteed to 404 on every image.
NEXT_PUBLIC_HOST_ORIGINALS=false
