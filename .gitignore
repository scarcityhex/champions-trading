node_modules/
.next/
out/
.env*
!.env.example
*.tsbuildinfo
next-env.d.ts
.DS_Store

# Written by `vercel deploy` on first run: the project and org ids that link
# this folder to a Vercel project. Not secret, but account-specific — someone
# who clones this repo should get their own, not inherit mine.
.vercel/

# Full-size collection artwork: ~2 GB. Not committed. Regenerate the folder by
# running the downloader, or symlink it.
/public/art/

# The image tiers are NOT committed — 187 MB of artwork that is not ours to
# redistribute. `vercel deploy` uploads the local folder directly, so they still
# reach the CDN without ever entering git history. That is what keeps the
# owner's permission revocable: a public git history cannot be un-published.
#
# See NOTICE. Regenerate either tier with `python3 scripts/gen_thumbs.py`;
# burned tokens are skipped automatically.
#
# NOTE: .vercelignore must exist and must NOT list these. Without it the Vercel
# CLI falls back to this file and would silently deploy a site with no images.
/public/thumbs/
/public/detail/

# Generated by `next dev` / `next build` on every run: framework boilerplate
# telling AI agents to read Next's own docs under node_modules. Says nothing
# about this project, and committing it would dirty the tree on every start.
/AGENTS.md
/CLAUDE.md
.vercel
.env*.local

# Python bytecode from scripts/
__pycache__/
